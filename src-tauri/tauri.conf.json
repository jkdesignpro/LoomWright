{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoomWright",
  "version": "0.4.0",
  "identifier": "org.loomwright.app",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LoomWright",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Wiring diagram editor",
    "longDescription": "Free, open-source wiring diagram editor for vehicle and electronics projects.",
    "copyright": "Copyright (C) 2026 LoomWright contributors. AGPL-3.0-or-later.",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["loom"],
        "name": "LoomWright diagram",
        "description": "LoomWright wiring diagram",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ]
  }
}
